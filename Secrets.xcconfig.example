// Secrets.xcconfig
// 复制此文件为 Secrets.xcconfig 并填入你的服务器地址
// cp Secrets.xcconfig.example Secrets.xcconfig

API_BASE_URL = https:/$()/your-ncm-server.com
QQ_MUSIC_BASE_URL = http:/$()/your-qq-server:8000
UNBLOCK_SERVER_URL = http:/$()/your-unblock-server:4000

// 可选：备用线路（配置后 App 自动启用多线路故障切换/繁忙分流）
// API_BASE_URL_BACKUP = https:/$()/your-backup-ncm-server.com
// QQ_MUSIC_BASE_URL_BACKUP = https:/$()/your-backup-qq-server.com
// QISHUI_BASE_URL_BACKUP = https:/$()/your-backup-qq-server.com/qishui
// API_BASE_URL_BACKUP_2 = https:/$()/your-second-backup-ncm-server.com
// QQ_MUSIC_BASE_URL_BACKUP_2 = https:/$()/your-second-backup-qcm-server.com
// QISHUI_BASE_URL_BACKUP_2 = https:/$()/your-second-backup-qishui-server.com
VIP_COOKIE = MUSIC_U=your_vip_cookie_here
